# ── OpenAI (agent LLM + Whisper STT + embeddings) ──
OPENAI_API_KEY=sk-...

# ── Supabase ────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...    # service_role key (not anon)

# ── Twilio ──────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── ElevenLabs (TTS) ────────────────────────────
ELEVENLABS_API_KEY=sk_...
# Voice ID from your ElevenLabs library (default below is "George")
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRTpX

# ── App ─────────────────────────────────────────
# Public base URL so Twilio can call back (use ngrok for local dev)
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok.io

# LLM model to use for the agent
AGENT_LLM_MODEL=gpt-4o

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# Whisper model
WHISPER_MODEL=whisper-1
